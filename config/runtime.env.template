# Copy this file to config/runtime.local.env (recommended) and fill your secrets.
# runtime.local.env is gitignored.

# Telegram bot identity and token
TELEGRAM_BOT_USERNAME=MioooooooooBot
TELEGRAM_BOT_KEY=
# Comma/space separated Telegram numeric user IDs or @usernames allowed to use private admin commands.
TELEGRAM_ADMIN_USER_IDS=

# Azure OpenAI settings (used when provider is azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# Ark/Volcengine settings (used when provider is ark)
ARK_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_API_KEY=
ARK_MODEL=doubao-seed-1-8-251228
ARK_VISION_MODEL=doubao-seed-1-6-251015

# Provider selection
LLM_PROVIDER=ark
LLM_ENABLE_THINKING=0

# Optional local LLM (used when provider is ollama)
OLLAMA_ENDPOINT=http://100.69.97.8:11434
OLLAMA_MODEL=gpt-oss:20b

# SQLite database path (persistent by default)
DB_FILE=data/message_history.db

# Message history controls
MESSAGE_REVIEW_BACK=80
RAG_TOP_K=12

# Sticker reply controls
STICKER_REPLY_ENABLED=1
STICKER_REPLY_CANDIDATE_LIMIT=12
STICKER_REPLY_COOLDOWN_MINUTES=30

# Personal memory candidate extraction controls
MEMORY_CANDIDATE_EXTRACTION_ENABLED=1
MEMORY_CANDIDATE_AUTO_REFRESH_COUNT=3

# RAG embedding settings
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
